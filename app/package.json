{
  "name": "pa-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK_CORE=1 vite --port 5173",
    "build:core": "wasm-pack build ../wasm --target web --out-dir ../app/src/core-wasm --release --no-pack",
    "build:web": "npm run build:core && npm run build",
    "build": "tsc --noEmit && vite build",
    "build:mock": "VITE_MOCK_CORE=1 npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:app": "node e2e/run.cjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.0.18"
  }
}
